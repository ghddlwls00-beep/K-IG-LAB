  "chunkDrills": [
    {
      "ko": "나의 선생님은 나를 도와주신다.",
      "en": "My teacher is helping me"
    },
    {
      "ko": "나의 꿈은 깨닫도록",
      "en": "realize my dreams."
    },
    {
      "ko": "나의 선생님은 또한 항상",
      "en": "My teacher also always"
    },
    {
      "ko": "우리가 목표를 세우라고 말하신다.",
      "en": "tells us to set goals"
    },
    {
      "ko": "우리의 꿈을 실행하기 위해서",
      "en": "in order to reach our dreams."
    },
    {
      "ko": "우리는 반드시 책을 많이 읽어야 한다고",
      "en": "we must read a lot of books."
    },
    {
      "ko": "그리고 우리의 좋은 소질들을 가르쳐 주신다.",
      "en": "and points out our good qualities."
    },
    {
      "ko": "나의 선생님은 항상 말씀하신다.",
      "en": "My teacher always says"
    },
    {
      "ko": "내가 선생님이 되어야 한다고",
      "en": "that I should be a teacher"
    },
    {
      "ko": "나의 좋은 자질 때문에",
      "en": "because of my good qualities."
    }
  ]
}