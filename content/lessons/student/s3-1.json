        {
          "n": "1",
          "text": "He/She is one of my best friends."
        },
        {
          "n": "2",
          "text": "I would like to introduce my friend to you. Allow me to introduce my friend to you."
        },
        {
          "n": "3",
          "text": "I would like to introduce my friend to you."
        }
      ]
    },
