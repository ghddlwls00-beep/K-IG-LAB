    {
      "type": "instruction",
      "text": "Principle 9. A day"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "102",
          "text": "I get up at 6 o'clock every morning."
        },
        {
          "n": "103",
          "text": "I clean my room, and go jogging with my dog."
        },
        {
          "n": "104",
          "text": "After I finish jogging, I take a shower."
        },
        {
          "n": "105",
          "text": "I have breakfast at 7:30 and go to school around 8 o'clock."
        },
        {
          "n": "106",
          "text": "I have four classes that start at 9."
        },
        {
          "n": "107",
          "text": "After lunch I have two more classes."
        },
        {
          "n": "108",
          "text": "I finish my classes at 3 p.m."
        },
        {
          "n": "109",
          "text": "After school I take piano lessons and go to an English Academy."
        },
        {
          "n": "110",
          "text": "Sometimes I'm very tired but I like to study with my friends."
        },
        {
          "n": "111",
          "text": "I get home around 6 p.m."
        },
        {
          "n": "112",
          "text": "When my family has dinner together, we talk about our days."
        },
        {
          "n": "113",
          "text": "After dinner I start my homework around 9 o'clock."
        },
        {
          "n": "114",
          "text": "After that I write in my journal about my day"
        }
      ]
    },
    {
      "type": "paragraph",
      "text": "and think what a wonderful day it was."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "115",
          "text": "I go to bed around 10:30."
        }
      ]
    },
