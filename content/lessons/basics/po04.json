      "text": "Principle 4. Relative-Introduction"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "36",
          "text": "I have many relatives."
        },
        {
          "n": "37",
          "text": "My father has two brothers and one sister."
        },
        {
          "n": "38",
          "text": "My father is the second son."
        },
        {
          "n": "39",
          "text": "My mother has one brother and three sisters."
        },
        {
          "n": "40",
          "text": "My mother is the first daughter."
        },
        {
          "n": "41",
          "text": "My uncles and aunts are all married."
        },
        {
          "n": "42",
          "text": "I have twelve cousins."
        },
        {
          "n": "43",
          "text": "My favorite relative is my oldest uncle."
        },
        {
          "n": "44",
          "text": "He's very kind and generous."
        },
        {
          "n": "45",
          "text": "He can play the piano and the guitar very well."
        },
        {
          "n": "46",
          "text": "He can speak both English and French."
        },
        {
          "n": "47",
          "text": "I really admire him."
        }
      ]
