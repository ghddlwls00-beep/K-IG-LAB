  "blocks": [
    {
      "type": "instruction",
      "text": "원리 20. 유명한 장소들"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "250",
          "text": "우리나라에는 / 경주와 제주도 / 같은 / 방문할 만한 / 아름다운 곳이 많아."
        },
        {
          "n": "251",
          "text": "한국 민속촌은 / 서울에서 멀지 않은 / 경기도에 / 있어."
        },
        {
          "n": "252",
          "text": "네가 그 곳을 방문하면, / 넌 / 옛날 한국의 / 삶이 어떠했는지 / 알게 될 거야."
        },
        {
          "n": "253",
          "text": "매년 / 많은 외국인들이 / 그곳을 / 방문해."
        },
        {
          "n": "254",
          "text": "경주는 / 신라 왕국의 / 옛 수도 / 였어."
        },
        {
          "n": "255",
          "text": "신라는 / 8세기에 / 가장 강력했던 왕국 / 이었어."
        },
        {
          "n": "256",
          "text": "많은 사람들은 / 경주가 / 벽 없는 / 박물관이라고 / 생각해."
        },
        {
          "n": "257",
          "text": "신라 왕조로부터 / 아직까지 남아 있는 / 많은 유적지들이 / 있어."
        },
        {
          "n": "258",
          "text": "제주도에는 / 재미있게 할만한 것들이 / 아주 많이 / 있어."
        },
        {
          "n": "259",
          "text": "난 / 한라산에 / 가는 것을 / 좋아해."
        },
        {
          "n": "260",
          "text": "한라산은 / 남한에서 / 가장 높은 산 / 이야."
        },
        {
          "n": "261",
          "text": "넌 / 아름다운 폭포들을 / 감상할 수도 있어."
        },
        {
          "n": "262",
          "text": "제주도는 / 방학 때 / 내가 가장 가고 싶은 곳 / 이야."
        }
      ]
    },
