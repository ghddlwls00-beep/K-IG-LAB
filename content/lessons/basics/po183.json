          "n": "233",
          "text": "Chuseok is one of the most popular national holidays of the year."
        },
        {
          "n": "234",
          "text": "It's often called the Korean Thanksgiving Day."
        },
        {
          "n": "235",
          "text": "All my relatives get together and have a good time."
        },
        {
          "n": "236",
          "text": "People visit their ancestors' tombs."
        },
        {
          "n": "237",
          "text": "We enjoy the full moon at night."
        }
