      "type": "instruction",
      "text": "Principle 2. Family-Introduction"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "12",
          "text": "There are four people in my family : my father, my mother, my sister and I."
        },
        {
          "n": "13",
          "text": "My father is a dentist."
        },
        {
          "n": "14",
          "text": "My mother teaches math at a school."
        },
        {
          "n": "15",
          "text": "My father is always helpful and kind."
        },
        {
          "n": "16",
          "text": "He often goes shopping with my mother."
        },
        {
          "n": "17",
          "text": "I admire him."
        },
        {
          "n": "18",
          "text": "My mother is very friendly."
        },
        {
          "n": "19",
          "text": "And she is a good cook."
        },
        {
          "n": "20",
          "text": "I have a sister."
        },
        {
          "n": "21",
          "text": "She goes to Korea Middle School."
        },
        {
          "n": "22",
          "text": "She likes all kinds of animals and she is interested in raising them."
        },
        {
          "n": "23",
          "text": "She also enjoys listening to music."
        },
        {
          "n": "24",
          "text": "I love my family."
        }
      ]
    },
