    {
      "type": "instruction",
      "text": "Principle 7. At the academy"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "75",
          "text": "After school, I take piano lessons and go to an English Academy, too."
        },
        {
          "n": "76",
          "text": "Some of my friends go to more academies than I do."
        },
        {
          "n": "77",
          "text": "They are very busy."
        },
        {
          "n": "78",
          "text": "I enjoy going to the English Academy the most."
        },
        {
          "n": "79",
          "text": "Everyday I learn new words, sentences and songs."
        },
        {
          "n": "80",
          "text": "I want to speak English fluently."
        },
        {
          "n": "81",
          "text": "At the English Academy, I have various kinds of friends."
        },
        {
          "n": "82",
          "text": "Some are good at memorizing words and English conversation."
        },
        {
          "n": "83",
          "text": "Others have really good pronunciation."
        },
        {
          "n": "84",
          "text": "I have a Korean English teacher."
        },
        {
          "n": "85",
          "text": "When he speaks English, he sounds like a native English speaker."
        },
        {
          "n": "86",
          "text": "I want to be able to speak English as well as he does."
        }
      ]
    },
