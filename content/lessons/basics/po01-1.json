  "blocks": [
    {
      "type": "instruction",
      "text": "원리 1. 자기 소개"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "내 이름은 / 김민우 / 야."
        },
        {
          "n": "2",
          "text": "난 / 서울에 / 살아."
        },
        {
          "n": "3",
          "text": "난 / 12살 / 이야."
        },
        {
          "n": "4",
          "text": "난 / 5학년 / 이야."
        },
        {
          "n": "5",
          "text": "난 / 고려 초등학교에 / 다녀."
        },
        {
          "n": "6",
          "text": "난 / 좀 / 활동적인 사람 / 이야."
        },
        {
          "n": "7",
          "text": "난 / 많은 친구들이 / 있어."
        },
        {
          "n": "8",
          "text": "대부분 사람들은 / 나를 / 좋아해."
        },
        {
          "n": "9",
          "text": "내 취미는 / 음악 듣기, / 영화 보기, / 그리고 스포츠를 하는 것 / 이야."
        },
        {
          "n": "10",
          "text": "내가 가장 좋아하는 과목은 / 영어 / 야."
        },
        {
          "n": "11",
          "text": "그래서 / 난 / 매일 / 영어를 / 공부해."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        "1 번",
        "2 번",
        "3 번",
        "4 번",
        "5 번"
      ]
    },
