      "items": [
        {
          "n": "90",
          "text": "How did the government boost its sale?"
        },
        {
          "n": "91",
          "text": "The company isn't running the ads, is it?"
        },
        {
          "n": "92",
          "text": "Oral tobacco carries its own health risks, doesn't it?"
        },
        {
          "n": "93",
          "text": "My husband is winning, isn't he?"
        },
        {
          "n": "94",
          "text": "Look at that!"
        },
        {
          "n": "95",
          "text": "I totally won the bet."
        },
        {
          "n": "96",
          "text": "Olympia is taking the Pepsi challenge."
        },
        {
          "n": "97",
          "text": "Why is the fast food chain switching its soft drink?"
        },
        {
          "n": "98",
          "text": "Who offered a better deal?"
        },
        {
          "n": "99",
          "text": "All 1900 Olympia outlets will be serving it within 60 days, won't they?"
        },
        {
          "n": "100",
          "text": "Coca Cola also is based in Atlanta, isn't it?"
        },
        {
          "n": "101",
          "text": "Didn't it try to get a temporary restraining order?"
        },
        {
          "n": "102",
          "text": "Why is the judge refusing to stop the switch?"
        },
        {
          "n": "103",
          "text": "It will seek arbitration, won't it?"
        },
        {
          "n": "104",
          "text": "How long will it take?"
        },
        {
          "n": "105",
          "text": "When am I going to(shall I, will I) meet your friends and your brothers?"
        },
        {
          "n": "106",
          "text": "You can't attend the party because you have a previous engagement, can you?"
        },
        {
          "n": "107",
          "text": "Did you get(reach) there on time?"
        },
        {
          "n": "108",
          "text": "Didn't you drop your handkerchief?"
        }
      ]
