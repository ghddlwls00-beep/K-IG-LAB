    {
      "type": "sentences",
      "items": [
        {
          "n": "23",
          "text": "그녀는 그를 그리워하지?(miss)"
        },
        {
          "n": "24",
          "text": "나의 개가 그 뼈들을 다 먹었지?"
        },
        {
          "n": "25",
          "text": "그는 뭘 하고 있나?"
        },
        {
          "n": "26",
          "text": "너는 그 사고를 기억하니?"
        },
        {
          "n": "27",
          "text": "너는 농담하고 있니?(kid)"
        },
        {
          "n": "28",
          "text": "너는 농담하고 있지?"
        },
        {
          "n": "29",
          "text": "너는 언제 그 밤에 대하여 생각하니?"
        },
        {
          "n": "30",
          "text": "너는 누군가를 만났지?"
        },
        {
          "n": "31",
          "text": "그는 누군가를 만나지?"
        },
        {
          "n": "32",
          "text": "너는 이해하지 않는다."
        },
        {
          "n": "33",
          "text": "나의 부모님은 나를 이해하시지 않는다."
        },
        {
          "n": "34",
          "text": "너의 선생님은 너를 이해하지 않지?"
        },
        {
          "n": "35",
          "text": "너는 그녀의 부모님을 만났니?"
        },
        {
          "n": "36",
          "text": "너는 이 주말에 일하고 있지 않니?"
        },
        {
          "n": "37",
          "text": "너의 사장은 일요일에 일하고 있니?"
        },
        {
          "n": "38",
          "text": "언제 우리가 이것에 대하여 이야기했니?"
        },
        {
          "n": "39",
          "text": "누가 이것에 대하여 이야기하니?"
        },
        {
          "n": "40",
          "text": "나는 바쁜 여자다."
        },
        {
          "n": "41",
          "text": "나는 누이가 있었다."
        },
        {
          "n": "42",
          "text": "너의 어머니는 얼마나 많은 누이가 있니?"
        },
        {
          "n": "43",
          "text": "너는 그 색깔을 좋아하니?"
        },
        {
          "n": "44",
          "text": "그는 그녀를 그리워하지?"
        }
      ]
    },
