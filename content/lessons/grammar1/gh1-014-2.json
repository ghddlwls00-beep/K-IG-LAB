    {
      "type": "sentences",
      "items": [
        {
          "n": "23",
          "text": "그녀는 아름답지?"
        },
        {
          "n": "24",
          "text": "누가 그것을 좋아하지 않나?"
        },
        {
          "n": "25",
          "text": "그녀는 그것을 좋아하지 않는다."
        },
        {
          "n": "26",
          "text": "나도 그래."
        },
        {
          "n": "27",
          "text": "아무도 그것을 좋아하지 않아."
        },
        {
          "n": "28",
          "text": "누구라도 (Anybody)그것을 좋아한다."
        },
        {
          "n": "29",
          "text": "모든 사람이 (Everybody) 그것을 좋아한다."
        },
        {
          "n": "30",
          "text": "그는 핸섬하고, 친절하고 또 영리하기도 하다."
        },
        {
          "n": "31",
          "text": "나는 집에 있다 (왔다:나 집에 왔어)."
        },
        {
          "n": "32",
          "text": "나도 그래."
        },
        {
          "n": "33",
          "text": "그는 집으로 오고 있다."
        },
        {
          "n": "34",
          "text": "그녀도 집으로 오고 있니?"
        },
        {
          "n": "35",
          "text": "나는 그것을 좋아하지 않는다."
        },
        {
          "n": "36",
          "text": "나도 그래."
        },
        {
          "n": "37",
          "text": "누구는 좋아하나?"
        },
        {
          "n": "38",
          "text": "모든 학생이 각각 자기 방이 있다. (each)"
        },
        {
          "n": "39",
          "text": "그는 매년 그곳에 간다.(each year)"
        },
        {
          "n": "40",
          "text": "그는 그의 아들 각각에게 돈을 주었다"
        },
        {
          "n": "41",
          "text": "모두(각각) 서로를 미워했다.(each)"
        },
        {
          "n": "42",
          "text": "그들은 서로 사랑했다."
        },
        {
          "n": "43",
          "text": "그는 모든 면에서 신사이다."
        }
      ]
    },
