    {
      "type": "instruction",
      "text": "영작문제 6 답안"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "How did he go there?"
        },
        {
          "n": "2",
          "text": "How fast does he go there?"
        },
        {
          "n": "3",
          "text": "How fast does the girl come here?"
        },
        {
          "n": "4",
          "text": "How much do you want?"
        },
        {
          "n": "5",
          "text": "How much money do you need?"
        },
        {
          "n": "6",
          "text": "How much water does he need?"
        },
        {
          "n": "7",
          "text": "He has more money than I."
        },
        {
          "n": "8",
          "text": "Do you want some more?"
        },
        {
          "n": "9",
          "text": "He came here as soon as possible."
        },
        {
          "n": "10",
          "text": "How many girls were there?"
        },
        {
          "n": "11",
          "text": "How much does she love him?"
        },
        {
          "n": "12",
          "text": "How long is the holiday?"
        },
        {
          "n": "13",
          "text": "How many times did you meet her?"
        },
        {
          "n": "14",
          "text": "What time does he go to school?"
        },
        {
          "n": "15",
          "text": "Why did all the boys go there?"
        },
        {
          "n": "16",
          "text": "How long does he study in the library every day?"
        },
        {
          "n": "17",
          "text": "How many hours were you in Japan?"
        },
        {
          "n": "18",
          "text": "How do all the boys go there?"
        },
        {
          "n": "19",
          "text": "Did you have a nice dinner?"
        },
        {
          "n": "20",
          "text": "How many boys were (there) in the library?"
        },
        {
          "n": "21",
          "text": "How many girls went there?"
        },
        {
          "n": "22",
          "text": "How does she go there?"
        },
        {
          "n": "23",
          "text": "Where does he go?"
        },
        {
          "n": "24",
          "text": "How often does she come here?"
        },
        {
          "n": "25",
          "text": "Where does she live?"
        },
        {
          "n": "26",
          "text": "Who loves you more than I?"
        },
        {
          "n": "27",
          "text": "Why doesn't he (does he not) welcome me?"
        },
        {
          "n": "28",
          "text": "What does he know?"
        },
        {
          "n": "29",
          "text": "Do you enjoy every minute of the trip?"
        },
        {
          "n": "30",
          "text": "No boy likes it."
        },
        {
          "n": "31",
          "text": "All of them don't like it."
        },
        {
          "n": "32",
          "text": "What can I do?"
        }
      ]
