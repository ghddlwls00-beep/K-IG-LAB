    },
    {
      "type": "instruction",
      "text": "영작문제 1"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "나는 행복하다."
        },
        {
          "n": "2",
          "text": "그는 슬프다."
        },
        {
          "n": "3",
          "text": "너는 가난하다."
        },
        {
          "n": "4",
          "text": "그녀는 건강하다."
        },
        {
          "n": "5",
          "text": "우리는 젊다."
        },
        {
          "n": "6",
          "text": "그들은 학생들이다."
        },
        {
          "n": "7",
          "text": "이것은 나의 모자다."
        },
        {
          "n": "8",
          "text": "이것들은 너의 구두들이다."
        },
        {
          "n": "9",
          "text": "그것들은 그들의 총들이다."
        },
        {
          "n": "10",
          "text": "나의 고양이는 귀엽다."
        },
        {
          "n": "11",
          "text": "이것은 너의 것이다."
        },
        {
          "n": "12",
          "text": "그것은 나의 것이다."
        },
        {
          "n": "13",
          "text": "나는 건강한가?"
        },
        {
          "n": "14",
          "text": "그는 유명한가?"
        },
        {
          "n": "15",
          "text": "그녀는 늙은가?"
        },
        {
          "n": "16",
          "text": "너는 슬프니?"
        },
        {
          "n": "17",
          "text": "나의 차는 좋니?"
        },
        {
          "n": "18",
          "text": "그들은 강한가?"
        },
        {
          "n": "19",
          "text": "그녀의 이름은 무엇이냐?"
        },
        {
          "n": "20",
          "text": "그 학생들은 어디에 있나?"
        },
        {
          "n": "21",
          "text": "그 소녀는 어디에 있나?"
        },
        {
          "n": "22",
          "text": "나의 차는 어디에 있나?"
        },
        {
          "n": "23",
          "text": "나의 안경(glasses)은 어디에 있나?"
        },
        {
          "n": "24",
          "text": "그녀는 무엇이냐?"
        },
        {
          "n": "25",
          "text": "그는 너의 남자친구냐?"
        },
        {
          "n": "26",
          "text": "그들은 너의 선생님들이냐?"
        },
        {
          "n": "27",
          "text": "이 소녀들은 너의 친구들이냐?"
        },
        {
          "n": "28",
          "text": "그것은 누구의 차냐?"
        },
        {
          "n": "29",
          "text": "너의 어머니는 행복하시니?"
        },
        {
          "n": "30",
          "text": "이 건물은 너의 것이냐?"
        },
        {
          "n": "31",
          "text": "그것들은 너의 것이냐?"
        },
        {
          "n": "32",
          "text": "그것은 나의 것이냐?"
        },
        {
          "n": "33",
          "text": "너의 형제들은 어디에 있나?"
        },
        {
          "n": "34",
          "text": "너의 누이는 어디에 있나?"
        },
        {
          "n": "35",
          "text": "너의 부모님은 어디에 계시니?"
        },
        {
          "n": "36",
          "text": "너의 부인은 어떠시니?"
        },
        {
          "n": "37",
          "text": "그녀는 너의 딸이니?"
        },
        {
          "n": "38",
          "text": "지금 여덟시냐?"
        },
        {
          "n": "39",
          "text": "지금은 아홉시다."
        },
        {
          "n": "40",
          "text": "덥니?"
        },
        {
          "n": "41",
          "text": "아니, 덥지 않아."
        },
        {
          "n": "42",
          "text": "시원하다."
        }
      ]
    },
