      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "Why does she go there?"
        },
        {
          "n": "2",
          "text": "This is my wife."
        },
        {
          "n": "3",
          "text": "This book is cheap."
        },
        {
          "n": "4",
          "text": "These are my pencils."
        },
        {
          "n": "5",
          "text": "These pens are cheap."
        },
        {
          "n": "6",
          "text": "Those(They) are her books."
        },
        {
          "n": "7",
          "text": "Those(The) pencils are theirs."
        },
        {
          "n": "8",
          "text": "It(That) is her car."
        },
        {
          "n": "9",
          "text": "It(That) is your dog."
        },
        {
          "n": "10",
          "text": "That(The) car is mine."
        },
        {
          "n": "11",
          "text": "This lady did it."
        },
        {
          "n": "12",
          "text": "Why did he study it(that)?"
        },
        {
          "n": "13",
          "text": "Why are you studying it?"
        },
        {
          "n": "14",
          "text": "Why were you not(weren't you) studying English?"
        },
        {
          "n": "15",
          "text": "When were they studying English?"
        },
        {
          "n": "16",
          "text": "Where were they studying English?"
        },
        {
          "n": "17",
          "text": "Where was he studying English?"
        },
        {
          "n": "18",
          "text": "Why is he happy?"
        }
