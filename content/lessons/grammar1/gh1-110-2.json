    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "90",
          "text": "그 정부가 어떻게 판매를 올렸나?"
        },
        {
          "n": "91",
          "text": "그 회사는 그 광고를 게제하고 있지 않지?"
        },
        {
          "n": "92",
          "text": "씹는담배는 그 자체의 건강상의 위험을 수반하지?"
        },
        {
          "n": "93",
          "text": "내 남편이 이기고 있지?"
        },
        {
          "n": "94",
          "text": "저것 봐!"
        },
        {
          "n": "95",
          "text": "내가 그 내기에서 완전히 이겼어."
        },
        {
          "n": "96",
          "text": "올림피아가 그 펩시의 도전을 받아들이고 있다."
        },
        {
          "n": "97",
          "text": "왜 그 패스트푸드 체인이 그것의 청량음료를 바꾸고 있니?"
        },
        {
          "n": "98",
          "text": "누가 더 나은 제안을 했나?"
        },
        {
          "n": "99",
          "text": "모든 1900 올림피아 매장이 60일 내에 그것을 서브(제공)하고 있게 되겠지?"
        },
        {
          "n": "100",
          "text": "코카콜라도 애틀랜타에 본부를 두고 있지?"
        },
        {
          "n": "101",
          "text": "그것은 일시적인 억제명령을 받아내려고 애쓰지 않았니?"
        },
        {
          "n": "102",
          "text": "왜 그 판사는 그 전환을 중단시키기를 거부하고 있나?"
        },
        {
          "n": "103",
          "text": "그것은 중재를 모색하겠지?"
        },
        {
          "n": "104",
          "text": "그것이 얼마나 오래 걸릴까?"
        },
        {
          "n": "105",
          "text": "내가 언제 너의 친구들과 형제들을 만날까?"
        },
        {
          "n": "106",
          "text": "너는 선약이 있어서 그 파티에 참석하지 못하지?"
        },
        {
          "n": "107",
          "text": "너는 정시에 그곳에 도착했니?"
        },
        {
          "n": "108",
          "text": "너는 너의 손수건을 떨어뜨리지 않았나?"
        }
      ]
    },
