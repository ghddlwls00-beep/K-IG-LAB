    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "20",
          "text": "나도 그래(나도 원해)"
        },
        {
          "n": "21",
          "text": "나의 어머니도 그래."
        },
        {
          "n": "22",
          "text": "그녀는 피곤해 보이지?"
        },
        {
          "n": "23",
          "text": "누가 그를 돕니?"
        },
        {
          "n": "24",
          "text": "누가 그녀를 돕지 않나?"
        },
        {
          "n": "25",
          "text": "그녀는 그것을 갖고 있지 않다."
        },
        {
          "n": "26",
          "text": "그는 집으로 오고 있다."
        },
        {
          "n": "27",
          "text": "그가 이곳으로 오고 있지 않나?"
        },
        {
          "n": "28",
          "text": "그녀는 모든 면에서 숙녀였다."
        },
        {
          "n": "29",
          "text": "각 학생이 자기 자신의 생각을 갖고 있다. (idea)"
        },
        {
          "n": "30",
          "text": "각 학생이 자기 자신의 계획을 갖고 있나?"
        },
        {
          "n": "31",
          "text": "너는 행복하지 않나?"
        },
        {
          "n": "32",
          "text": "그는 그의 아들들 각자에게 돈을 주지 않았나?"
        },
        {
          "n": "33",
          "text": "그녀는 그녀의 딸들 각자에게 돈을 주지 않나?"
        },
        {
          "n": "34",
          "text": "그는 매일 그곳에 가나?"
        },
        {
          "n": "35",
          "text": "그는 인기 있지 않나?"
        },
        {
          "n": "36",
          "text": "그들은 인기 있지 않았나?"
        },
        {
          "n": "37",
          "text": "나는 유명하지 않나?"
        }
      ]
    },
