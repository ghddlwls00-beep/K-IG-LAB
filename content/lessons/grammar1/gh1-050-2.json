    {
      "type": "sentences",
      "items": [
        {
          "n": "22",
          "text": "나의 차는 어디에 있나?"
        },
        {
          "n": "23",
          "text": "나의 안경(glasses)은 어디에 있나?"
        },
        {
          "n": "24",
          "text": "그녀는 무엇이냐?"
        },
        {
          "n": "25",
          "text": "그는 너의 남자친구냐?"
        },
        {
          "n": "26",
          "text": "그들은 너의 선생님들이냐?"
        },
        {
          "n": "27",
          "text": "이 소녀들은 너의 친구들이냐?"
        },
        {
          "n": "28",
          "text": "그것은 누구의 차냐?"
        },
        {
          "n": "29",
          "text": "너의 어머니는 행복하시니?"
        },
        {
          "n": "30",
          "text": "이 건물은 너의 것이냐?"
        },
        {
          "n": "31",
          "text": "그것들은 너의 것이냐?"
        },
        {
          "n": "32",
          "text": "그것은 나의 것이냐?"
        },
        {
          "n": "33",
          "text": "너의 형제들은 어디에 있나?"
        },
        {
          "n": "34",
          "text": "너의 누이는 어디에 있나?"
        },
        {
          "n": "35",
          "text": "너의 부모님은 어디에 계시니?"
        },
        {
          "n": "36",
          "text": "너의 부인은 어떠시니?"
        },
        {
          "n": "37",
          "text": "그녀는 너의 딸이니?"
        },
        {
          "n": "38",
          "text": "지금 여덟시냐?"
        },
        {
          "n": "39",
          "text": "지금은 아홉시다."
        },
        {
          "n": "40",
          "text": "덥니?"
        },
        {
          "n": "41",
          "text": "아니, 덥지 않아."
        },
        {
          "n": "42",
          "text": "시원하다."
        }
      ]
    },
