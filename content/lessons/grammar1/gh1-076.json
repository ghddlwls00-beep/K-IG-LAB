    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "한 문제가 있었니?"
        },
        {
          "n": "2",
          "text": "해결책들이 있었니? (solutions)?"
        },
        {
          "n": "3",
          "text": "한 가지 대답이 있니?"
        },
        {
          "n": "4",
          "text": "비디오테이프들이 있니?"
        },
        {
          "n": "5",
          "text": "그는 꿈을 갖고 있니?"
        },
        {
          "n": "6",
          "text": "그들은 돈을 갖고 있니?"
        },
        {
          "n": "7",
          "text": "나는 문제를 갖고 있었니?"
        },
        {
          "n": "8",
          "text": "너는 좋은 정책(policy)을 갖고 있었니?"
        },
        {
          "n": "9",
          "text": "내가 너를 아니? (댁에서 저를 아세요?)"
        },
        {
          "n": "10",
          "text": "그는 너를 아니?"
        },
        {
          "n": "11",
          "text": "그가 그것을 원하니?"
        },
        {
          "n": "12",
          "text": "그들은 그를 미워하니?"
        },
        {
          "n": "13",
          "text": "그는 그 음식을 좋아했다."
        },
        {
          "n": "14",
          "text": "한 그림이 있지 않았니?"
        },
        {
          "n": "15",
          "text": "왜 너는 그것을 좋아했니?"
        },
        {
          "n": "16",
          "text": "그들은 어디에 있었니?"
        },
        {
          "n": "17",
          "text": "그는 어디에 있었니?"
        },
        {
          "n": "18",
          "text": "왜 그는 그곳에 있었니?"
        },
        {
          "n": "19",
          "text": "왜 그들은 그곳에 가지 않았니?"
        },
        {
          "n": "20",
          "text": "그는 어디에 가니?"
        },
        {
          "n": "21",
          "text": "너의 어머니는 어디에 계셨니?"
        },
        {
          "n": "22",
          "text": "소년들이 있지 않았니?"
        },
        {
          "n": "23",
          "text": "왜 너는 한 꿈을 갖고 있지 않니?"
        },
        {
          "n": "24",
          "text": "너는 어디에서 공부하니?"
        },
        {
          "n": "25",
          "text": "너는 무엇을 좋아했니?"
        },
        {
          "n": "26",
          "text": "그들은 어디에 있었니?"
        },
        {
          "n": "27",
          "text": "왜 너는 놀랐니?"
        },
        {
          "n": "28",
          "text": "왜 그것은 재미있니?"
        }
      ]
    },
