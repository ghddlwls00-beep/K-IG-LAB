    {
      "type": "instruction",
      "text": "영작문제 2"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "나는 부유했다."
        },
        {
          "n": "2",
          "text": "그는 가난했다."
        },
        {
          "n": "3",
          "text": "그녀는 행복했다."
        },
        {
          "n": "4",
          "text": "너는 강했다."
        },
        {
          "n": "5",
          "text": "그들은 군인들이었다."
        },
        {
          "n": "6",
          "text": "우리는 근로자들이었다."
        },
        {
          "n": "7",
          "text": "이것들은 나의 개들이었다."
        },
        {
          "n": "8",
          "text": "이것은 나의 연필이었다."
        },
        {
          "n": "9",
          "text": "그것들은 그들의 소들이었다."
        },
        {
          "n": "10",
          "text": "나의 차는 파랬다."
        },
        {
          "n": "11",
          "text": "그것은 나의 것이었다."
        },
        {
          "n": "12",
          "text": "이것은 너의 것이었다."
        },
        {
          "n": "13",
          "text": "내가 인기 있었나?"
        },
        {
          "n": "14",
          "text": "그는 유명했나?"
        },
        {
          "n": "15",
          "text": "그녀는 부유했나?"
        },
        {
          "n": "16",
          "text": "너는 기혼이었니?"
        },
        {
          "n": "17",
          "text": "나의 손이 차가왔니?"
        },
        {
          "n": "18",
          "text": "그들은 아팠니?(병이 있었니?)"
        },
        {
          "n": "19",
          "text": "그녀의 꿈은 무엇이었니?"
        },
        {
          "n": "20",
          "text": "그들은 어디에 있었니?"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        "1 번",
        "2 번",
        "3 번",
        "4 번",
        "5 번"
