      "text": "영작문제 5"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "Who did this?"
        },
        {
          "n": "2",
          "text": "What does he want?"
        },
        {
          "n": "3",
          "text": "What can he do for me?"
        },
        {
          "n": "4",
          "text": "Why is she sitting there?"
        },
        {
          "n": "5",
          "text": "When does he come here?"
        },
        {
          "n": "6",
          "text": "Whose car is that(it)?"
        },
        {
          "n": "7",
          "text": "Whose pencils are those(they)?"
        },
        {
          "n": "8",
          "text": "Whom does he love?"
        },
        {
          "n": "9",
          "text": "Who loves her?"
        },
        {
          "n": "10",
          "text": "Which book does she want?"
        },
        {
          "n": "11",
          "text": "Which does his mother want?"
        },
        {
          "n": "12",
          "text": "That(It) is your car, isn't that(it)?"
        },
        {
          "n": "13",
          "text": "He loves her, doesn't he?"
        },
        {
          "n": "14",
          "text": "He doesn't have breakfast, does he?"
        },
        {
          "n": "15",
          "text": "She didn't have dinner, did she?"
        },
        {
          "n": "16",
          "text": "He needs much water, doesn't he?"
        },
        {
          "n": "17",
          "text": "The hospital wants much blood, doesn't it?"
        },
        {
          "n": "18",
          "text": "He is a gentleman, isn't he?"
        },
        {
          "n": "19",
          "text": "He wants apples."
        },
        {
          "n": "20",
          "text": "So do I."
        },
        {
          "n": "21",
          "text": "So does my mother."
        },
        {
          "n": "22",
          "text": "She looks tired, doesn't she?"
        },
        {
          "n": "23",
          "text": "Who helps him?"
        },
        {
          "n": "24",
          "text": "Who doesn't help her?"
        },
        {
          "n": "25",
          "text": "She doesn't have it."
        },
        {
          "n": "26",
          "text": "He is coming home."
        },
        {
          "n": "27",
          "text": "Isn't he(Is he not) coming here?"
        },
        {
          "n": "28",
          "text": "She was a lady in every way."
        },
        {
          "n": "29",
          "text": "Each(Every) student has his own idea."
        },
        {
          "n": "30",
          "text": "Does each(every) student have his own plan?"
        },
        {
          "n": "31",
          "text": "Aren't you(Are you not) happy?"
        },
        {
          "n": "32",
          "text": "Didn't he(Did he not) give money to each of his sons?"
        },
        {
          "n": "33",
          "text": "Doesn't she(Does she not) give money to each of her daughters?"
        },
        {
          "n": "34",
          "text": "Does he go there every day?"
        },
        {
          "n": "35",
          "text": "Isn't he(Is he not) popular?"
        },
        {
          "n": "36",
          "text": "Weren't they(Were they not) popular?"
        },
        {
          "n": "37",
          "text": "Am I not(ain't I) famous?"
        }
      ]
