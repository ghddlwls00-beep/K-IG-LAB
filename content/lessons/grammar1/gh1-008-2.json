    {
      "type": "sentences",
      "items": [
        {
          "n": "22",
          "text": "그는 어디 있었니?"
        },
        {
          "n": "23",
          "text": "너는 누구였니?"
        },
        {
          "n": "24",
          "text": "그녀는 어디 있었니?"
        },
        {
          "n": "25",
          "text": "그녀는 너의 여자 친구였니?"
        },
        {
          "n": "26",
          "text": "그들은 너의 친구들이었니?"
        },
        {
          "n": "27",
          "text": "이 소년들은 너의 급우들이었니?"
        },
        {
          "n": "28",
          "text": "이것은 누구의 펜이었니?"
        },
        {
          "n": "29",
          "text": "그녀는 아름다웠니?"
        },
        {
          "n": "30",
          "text": "이 펜은 너의 것이었니?"
        },
        {
          "n": "31",
          "text": "이것들은 너의 것들이었니?"
        },
        {
          "n": "32",
          "text": "이것이 나의 것이었니?"
        },
        {
          "n": "33",
          "text": "그들은 어디에 있었니?"
        },
        {
          "n": "34",
          "text": "그녀는 어디 있었니?"
        },
        {
          "n": "35",
          "text": "우리는 어디 있었니?"
        },
        {
          "n": "36",
          "text": "너의 어머니는 어땠니? (안녕하셨니)?"
        },
        {
          "n": "37",
          "text": "그는 너의 상사였니?"
        },
        {
          "n": "38",
          "text": "그때는 몇 시였니?"
        },
        {
          "n": "39",
          "text": "그때는 7시였다."
        },
        {
          "n": "40",
          "text": "어제는 날씨가 추웠니?"
        },
        {
          "n": "41",
          "text": "아니, 어제는 춥지 않았어."
        },
        {
          "n": "42",
          "text": "어제는 따뜻했다."
        }
      ]
    },
