    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "왜 너는 영어를 공부하니?"
        },
        {
          "n": "2",
          "text": "이 사람은 나의 친구이다."
        },
        {
          "n": "3",
          "text": "이 책은 비싸다."
        },
        {
          "n": "4",
          "text": "이것들은 나의 책들이다."
        },
        {
          "n": "5",
          "text": "이 책들은 싸다."
        },
        {
          "n": "6",
          "text": "그것들은 너의 책들이다."
        },
        {
          "n": "7",
          "text": "그 책들은 그들의 것들이다."
        },
        {
          "n": "8",
          "text": "그것은 그의 책이다."
        },
        {
          "n": "9",
          "text": "저것은 너의 차다."
        },
        {
          "n": "10",
          "text": "저 집은 나의 것이다."
        },
        {
          "n": "11",
          "text": "이 신사가 그것을 했다."
        },
        {
          "n": "12",
          "text": "왜 너는 영어를 공부했니?"
        },
        {
          "n": "13",
          "text": "왜 너는 영어를 공부하고 있니?"
        },
        {
          "n": "14",
          "text": "왜 너는 영어를 공부하고 있었니?"
        },
        {
          "n": "15",
          "text": "언제 그는 영어를 공부하고 있었니?"
        },
        {
          "n": "16",
          "text": "그녀는 어디에서 영어를 공부하고 있었니?"
        },
        {
          "n": "17",
          "text": "그들은 어디에서 영어를 공부하고 있었니?"
        },
        {
          "n": "18",
          "text": "왜 너는 행복하니?"
        },
        {
          "n": "19",
          "text": "왜 그녀는 슬펐니?"
        },
        {
          "n": "20",
          "text": "왜 그는 행복하니?"
        },
        {
          "n": "21",
          "text": "그들은 언제 행복하니?"
        },
        {
          "n": "22",
          "text": "너는 누구냐?"
        },
        {
          "n": "23",
          "text": "그는 누구냐?"
        },
        {
          "n": "24",
          "text": "그들은 누구냐?"
        },
        {
          "n": "25",
          "text": "그녀는 누구였니?"
        },
        {
          "n": "26",
          "text": "너는 무엇을 아니?"
        },
        {
          "n": "27",
          "text": "그는 누구를 아나?"
        },
        {
          "n": "28",
          "text": "그들은 누구를 아나?"
        },
        {
          "n": "29",
          "text": "그는 어디에서 사나?"
        },
        {
          "n": "30",
          "text": "그들은 어디에 가나?"
        },
        {
          "n": "31",
          "text": "왜 너는 달리고 있니?"
        },
        {
          "n": "32",
          "text": "왜 너는 나를 보니?"
        },
        {
          "n": "33",
          "text": "누가 그것을 좋아했니?"
        },
        {
          "n": "34",
          "text": "누가 그것을 좋아하니?"
        },
        {
          "n": "35",
          "text": "그는 무엇 이였니? (뭐하는 사람이었니?)"
        }
      ]
