    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "21",
          "text": "당신은 아침 식사로 무엇을 먹었나?"
        },
        {
          "n": "22",
          "text": "당신은 몇 시에 점심을 먹나?"
        },
        {
          "n": "23",
          "text": "그는 어디에서 점심을 먹나?"
        },
        {
          "n": "24",
          "text": "그녀는 패스트푸드를 좋아하나?"
        },
        {
          "n": "25",
          "text": "당신은 언제 한국에 왔나?"
        },
        {
          "n": "26",
          "text": "그는 언제 미국으로 돌아가나?"
        },
        {
          "n": "27",
          "text": "당신은 어디 출신인가?(두 가지로)"
        },
        {
          "n": "28",
          "text": "너는 어디 출신이니?"
        },
        {
          "n": "29",
          "text": "당신은 한국에서 행복하지 않나?"
        },
        {
          "n": "30",
          "text": "누가 고함지르나?"
        },
        {
          "n": "31",
          "text": "누가 우나?"
        },
        {
          "n": "32",
          "text": "당신의 아이들은 자주 우나?"
        },
        {
          "n": "33",
          "text": "왜 당신의 아이들은 울고 있나?"
        },
        {
          "n": "34",
          "text": "그 아기는 울고 있나?"
        },
        {
          "n": "35",
          "text": "당신의 여자 친구는 속삭이지만, 당신의 부인은 소리 지른다. (whisper, shout)"
        },
        {
          "n": "36",
          "text": "당신은 화났나?"
        },
        {
          "n": "37",
          "text": "누가 나를 찾아다녔나?"
        },
        {
          "n": "38",
          "text": "너의 어머니가 이것을 찾아다니셨니?"
        },
        {
          "n": "39",
          "text": "너의 할머니는 이것을 찾아다니지 않으셨지?"
        }
      ]
    },
