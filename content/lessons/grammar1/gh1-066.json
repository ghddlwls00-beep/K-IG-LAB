        },
        {
          "n": "66",
          "text": "누구나 그 집을 좋아하죠? (Everybody)"
        },
        {
          "n": "67",
          "text": "누구나 그 집을 좋아했죠? (Everybody)"
        },
        {
          "n": "68",
          "text": "아무도 그것을 좋아하지 않죠?"
        },
        {
          "n": "69",
          "text": "아무도 그것을 좋아하지 않았죠?"
        },
        {
          "n": "70",
          "text": "모든(Every) 소년이 한 상(a prize)을 받는다."
