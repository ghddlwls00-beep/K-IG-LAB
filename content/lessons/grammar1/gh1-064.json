    {
      "type": "sentences",
      "items": [
        {
          "n": "27",
          "text": "당신의 부모님에게는 꿈이 있지 않습니까?"
        },
        {
          "n": "28",
          "text": "당신의 아들은 꿈을 갖고 있지 않습니까? (단수로)"
        },
        {
          "n": "29",
          "text": "당신의 아버지는 당신의 어머니를 사랑하지 않습니까?"
        },
        {
          "n": "30",
          "text": "당신의 상사는 그것을 좋아합니까?"
        },
        {
          "n": "31",
          "text": "당신의 어머니는 그것을 좋아하지 않았습니까?"
        },
        {
          "n": "32",
          "text": "당신의 부인은 그것을 좋아했습니까?"
        },
        {
          "n": "33",
          "text": "당신의 남편은 꿈을 갖고 있습니까? (단수로)"
        },
        {
          "n": "34",
          "text": "당신의 친구들은 꿈을 갖고 있습니까? (단수로)"
        },
        {
          "n": "35",
          "text": "당신의 아내는 꿈을 갖고 있지 않습니까? (단수로)"
        },
        {
          "n": "36",
          "text": "당신의 어머니는 당신의 상사를 압니까?"
        },
        {
          "n": "37",
          "text": "그 학생들은 꿈을 갖고 있습니까? (단수로)"
        },
        {
          "n": "38",
          "text": "당신의 부모님은 꿈을 갖고 있지 않았습니까? (단수로)"
        },
        {
          "n": "39",
          "text": "왜 그는 영어를 공부합니까?"
        },
        {
          "n": "40",
          "text": "이 책은 비쌉니까?"
        },
        {
          "n": "41",
          "text": "이것들은 당신의 책들입니까?"
        },
        {
          "n": "42",
          "text": "왜 그들은 영어를 공부하고 있습니까?"
        },
        {
          "n": "43",
          "text": "왜 그는 영어를 공부하고 있었습니까?"
        },
        {
          "n": "44",
          "text": "왜 당신의 어머니는 행복합니까?"
        },
        {
          "n": "45",
          "text": "왜 당신의 부인은 행복했습니까?"
        },
        {
          "n": "46",
          "text": "왜 당신은 그녀를 보고 있습니까?"
        },
        {
          "n": "47",
          "text": "왜 그녀는 나를 보고 있었습니까?"
        },
        {
          "n": "48",
          "text": "왜 당신은 나를 봅니까?"
        },
        {
          "n": "49",
          "text": "왜 그는 달리고 있나?"
        },
        {
          "n": "50",
          "text": "그것들은 당신의 누이의 책들입니까?"
        },
        {
          "n": "51",
          "text": "이 책들은 비쌉니까?"
        },
        {
          "n": "52",
          "text": "이 차는 비싸지 않습니까?"
        },
        {
          "n": "53",
          "text": "누가 영어를 열심히 공부합니까?"
        }
      ]
    },
