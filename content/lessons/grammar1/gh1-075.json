    {
      "type": "heading",
      "text": "[ Page 075]"
    },
    {
      "type": "instruction",
      "text": "영작문제 2 답안"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "We were soldiers."
        },
        {
          "n": "2",
          "text": "This was mine."
        },
        {
          "n": "3",
          "text": "These were yours."
        },
        {
          "n": "4",
          "text": "Those(They) were theirs."
        },
        {
          "n": "5",
          "text": "His face was red."
        },
        {
          "n": "6",
          "text": "It(That) was hers."
        },
        {
          "n": "7",
          "text": "Where were your friends?"
        },
        {
          "n": "8",
          "text": "The car was his."
        },
        {
          "n": "9",
          "text": "What was her nickname?"
        },
        {
          "n": "10",
          "text": "Were they policemen (police officers)?"
        },
        {
          "n": "11",
          "text": "Was it hot yesterday?"
        },
        {
          "n": "12",
          "text": "Was I a good boy?"
        },
        {
          "n": "13",
          "text": "Was he a good student(pupil)?"
        },
        {
          "n": "14",
          "text": "Was she single?"
        },
        {
          "n": "15",
          "text": "Were you strong?"
        },
        {
          "n": "16",
          "text": "Was he your enemy?"
        },
        {
          "n": "17",
          "text": "Were they your teachers?"
        },
        {
          "n": "18",
          "text": "Were these girls happy?"
        },
        {
          "n": "19",
          "text": "Whose car was this?"
        },
        {
          "n": "20",
          "text": "Was he honest?"
        },
        {
          "n": "21",
          "text": "They were prisoners."
        },
        {
          "n": "22",
          "text": "Was that (the) land yours?"
        },
        {
          "n": "23",
          "text": "Were those yours?"
        },
        {
          "n": "24",
          "text": "Was this chair mine?"
        },
        {
          "n": "25",
          "text": "Were her socks red?"
        },
        {
          "n": "26",
          "text": "Where were they?"
        },
        {
          "n": "27",
          "text": "Who were they?"
        },
        {
          "n": "28",
          "text": "Where was your girlfriend?"
        },
        {
          "n": "29",
          "text": "How was your grandmother?"
        }
      ]
    },
