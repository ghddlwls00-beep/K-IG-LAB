    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "우리는 군인이었다."
        },
        {
          "n": "2",
          "text": "이것은 나의 것이었다."
        },
        {
          "n": "3",
          "text": "이것들은 너의 것들이었다."
        },
        {
          "n": "4",
          "text": "그것들은 그들의 것들이었다."
        },
        {
          "n": "5",
          "text": "그의 얼굴은 빨갰다."
        },
        {
          "n": "6",
          "text": "그것은 그녀의 것이었다."
        },
        {
          "n": "7",
          "text": "너의 친구들은 어디에 있었니?"
        },
        {
          "n": "8",
          "text": "그 차는 그의 것이었다."
        },
        {
          "n": "9",
          "text": "그녀의 별명은 무엇이었니? (nickname)?"
        },
        {
          "n": "10",
          "text": "그들은 경찰관들이었니?"
        },
        {
          "n": "11",
          "text": "어제는 더웠니?"
        },
        {
          "n": "12",
          "text": "나는 착한 소년이었습니까?"
        },
        {
          "n": "13",
          "text": "그는 좋은 학생이었니?"
        },
        {
          "n": "14",
          "text": "그녀는 독신이었니(single)?"
        },
        {
          "n": "15",
          "text": "너는 강했니(strong)?"
        },
        {
          "n": "16",
          "text": "그는 너의 적이었니?"
        },
        {
          "n": "17",
          "text": "그들은 너의 교사들이었니?"
        },
        {
          "n": "18",
          "text": "이 소녀들은 행복했니?"
        },
        {
          "n": "19",
          "text": "이것은 누구의 차였니?"
        },
        {
          "n": "20",
          "text": "그는 정직했니?"
        },
        {
          "n": "21",
          "text": "그들은 죄수들이었다."
        },
        {
          "n": "22",
          "text": "그 땅은 너의 것이었니?"
        },
        {
          "n": "23",
          "text": "그것들은 너의 것이었니?"
        },
        {
          "n": "24",
          "text": "이 의자는 나의 것이었니?"
        },
        {
          "n": "25",
          "text": "그녀의 양말은 빨갰니?"
        },
        {
          "n": "26",
          "text": "그들은 어디에 있었니?"
        },
        {
          "n": "27",
          "text": "그들은 누구였니?"
        },
        {
          "n": "28",
          "text": "너의 여자 친구는 어디에 있었니?"
        },
        {
          "n": "29",
          "text": "너의 할머니는 어떠셨니?"
        }
      ]
    },
