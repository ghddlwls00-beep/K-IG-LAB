    },
    {
      "type": "instruction",
      "text": "ABCD로 나누어서 외워주세요."
    },
    {
      "type": "hints",
      "text": "<A>"
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "이것은 너의 펜이냐?"
        },
        {
          "n": "2",
          "text": "이 펜은 너의 것이냐?"
        },
        {
          "n": "3",
          "text": "너의 아들은 건강한가?"
        },
        {
          "n": "4",
          "text": "이 소녀들은 누구의 급우들인가?"
        },
        {
          "n": "5",
          "text": "그들은 너의 형제들이냐?"
        },
        {
          "n": "6",
          "text": "나의 아들은 건강한가?"
        },
        {
          "n": "7",
          "text": "그 차는 너의 것이냐?"
        },
        {
          "n": "8",
          "text": "이 신사들은 너의 친구들이냐?"
        },
        {
          "n": "9",
          "text": "이것은 누구의 집이냐?"
        },
        {
          "n": "10",
          "text": "내가 어디에 있나(여기가 어디냐?)"
        },
        {
          "n": "11",
          "text": "오늘 따뜻한가?"
        },
        {
          "n": "12",
          "text": "너의 어머니는 건강하시니?"
        },
        {
          "n": "13",
          "text": "너의 남편은 가난했니?"
        },
        {
          "n": "14",
          "text": "그녀의 취미(hobby)는 무엇이었니?"
        },
        {
          "n": "15",
          "text": "오늘 그 학생들은 어디에 있나?"
        },
        {
          "n": "16",
          "text": "그 정치가들은 어디에 있었나?"
        },
        {
          "n": "17",
          "text": "너의 할머니는 예쁘셨니?"
        },
        {
          "n": "18",
          "text": "이것은 누구의 집이였니?"
        },
        {
          "n": "19",
          "text": "어제는 더웠니?"
        },
        {
          "n": "20",
          "text": "지난주는 더웠니?"
        },
        {
          "n": "21",
          "text": "이것은 너의 연필이었니?"
        },
        {
          "n": "22",
          "text": "이 연필은 너의 것이었니?"
        },
        {
          "n": "23",
          "text": "너의 아이들은 건강했니?"
        },
        {
          "n": "24",
          "text": "너의 어머니와 할아버지는 행복하셨니?"
        },
        {
          "n": "25",
          "text": "너의 자녀는 꿈이 있니? (단수로)"
        },
        {
          "n": "26",
          "text": "당신의 아들과 딸은 꿈이 있습니까?"
        }
      ]
    },
