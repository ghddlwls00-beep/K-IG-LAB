    {
      "type": "instruction",
      "text": "영작문제 2 답안"
    },
    {
      "type": "instruction",
      "text": "다음 문제를 영작해주세요."
    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "77",
          "text": "Each mayor received a warning, didn't he?"
        },
        {
          "n": "78",
          "text": "All the governors had a hard time, didn't they?"
        },
        {
          "n": "79",
          "text": "Every boy didn't lose his life, did he?"
        },
        {
          "n": "80",
          "text": "Each boy didn't wear glasses, did he?"
        },
        {
          "n": "81",
          "text": "All the boys didn't protect their sisters, did they?"
        },
        {
          "n": "82",
          "text": "All of them face a cleaning job."
        },
        {
          "n": "83",
          "text": "All of them didn't smell it."
        },
        {
          "n": "84",
          "text": "Nobody(No one) called."
        },
        {
          "n": "85",
          "text": "Nobody (No one) ignores it."
        },
        {
          "n": "86",
          "text": "Nobody(No one) is buying it, are they?"
        },
        {
          "n": "87",
          "text": "Nobody(No one) knows everything, do they?"
        },
        {
          "n": "88",
          "text": "Were there many researchers in the lab?"
        },
        {
          "n": "89",
          "text": "There were 60 officers in the police station, weren't there?"
        },
        {
          "n": "90",
          "text": "There weren't 60 officials in the office, were there?"
        },
        {
          "n": "91",
          "text": "Did many ministers go there?"
        },
        {
          "n": "92",
          "text": "Didn't many monks go to the temple?"
        },
        {
          "n": "93",
          "text": "Many principals went there, didn't they?"
        },
        {
          "n": "94",
          "text": "Many sergeants didn't go there, did they?"
        },
        {
          "n": "95",
          "text": "The surgeon paid for the medicine, didn't he?"
        }
      ]
    },
