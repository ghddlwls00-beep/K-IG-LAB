    {
      "type": "sentences",
      "items": [
        {
          "n": "22",
          "text": "그는 어디 있나?"
        },
        {
          "n": "23",
          "text": "너는 누구냐?"
        },
        {
          "n": "24",
          "text": "그는 무엇이냐? (신분이나 직업을 묻는 말)"
        },
        {
          "n": "25",
          "text": "그녀는 너의 여자 친구니?"
        },
        {
          "n": "26",
          "text": "그들은 너의 친구들이니?"
        },
        {
          "n": "27",
          "text": "이 소년들은 너의 급우들이니?"
        },
        {
          "n": "28",
          "text": "이것은 누구의 펜이니?"
        },
        {
          "n": "29",
          "text": "그녀는 아름답니?"
        },
        {
          "n": "30",
          "text": "이 펜은 너의 것이니?"
        },
        {
          "n": "31",
          "text": "이것들은 너의 것들이니?"
        },
        {
          "n": "32",
          "text": "이것은 나의 것이니?"
        },
        {
          "n": "33",
          "text": "그들은 어디 있나?"
        },
        {
          "n": "34",
          "text": "그녀는 어디에 있니?"
        },
        {
          "n": "35",
          "text": "우리는 어디에 있니? (여기가 어디냐?)"
        },
        {
          "n": "36",
          "text": "너의 어머니는 어떠시니?"
        },
        {
          "n": "37",
          "text": "그는 너의 상사니?"
        },
        {
          "n": "38",
          "text": "몇 시니?"
        },
        {
          "n": "39",
          "text": "7시이다."
        },
        {
          "n": "40",
          "text": "날씨가 춥니?"
        },
        {
          "n": "41",
          "text": "아니, 춥지 않아."
        },
        {
          "n": "42",
          "text": "따뜻해."
        }
      ]
    },
