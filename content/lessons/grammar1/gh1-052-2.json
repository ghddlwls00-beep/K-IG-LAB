    {
      "type": "sentences",
      "items": [
        {
          "n": "21",
          "text": "그는 어땠니?"
        },
        {
          "n": "22",
          "text": "그녀는 어디에 있었니?"
        },
        {
          "n": "23",
          "text": "그는 누구였니?"
        },
        {
          "n": "24",
          "text": "그녀는 무엇이었니?"
        },
        {
          "n": "25",
          "text": "그는 그녀의 남자친구였니?"
        },
        {
          "n": "26",
          "text": "이 소년들은 그녀의 급우들이었니?"
        },
        {
          "n": "27",
          "text": "그들은 그녀의 선생님들이었니?"
        },
        {
          "n": "28",
          "text": "이것들은 누구의 책들이었니?"
        },
        {
          "n": "29",
          "text": "그는 핸섬했니?"
        },
        {
          "n": "30",
          "text": "이 가방은 너의 것이었니?"
        },
        {
          "n": "31",
          "text": "그것들은 그녀의 것이었니?"
        },
        {
          "n": "32",
          "text": "그것은 나의 것이었니?"
        },
        {
          "n": "33",
          "text": "그 소녀들은 어디에 있었니?"
        },
        {
          "n": "34",
          "text": "너의 어머니는 어디에 계셨니?"
        },
        {
          "n": "35",
          "text": "너의 누이들은 어디에 있었니?"
        },
        {
          "n": "36",
          "text": "너의 가족은 어땠니?"
        },
        {
          "n": "37",
          "text": "그는 너의 학생이었니?"
        },
        {
          "n": "38",
          "text": "어제는 더웠니?"
        },
        {
          "n": "39",
          "text": "아니 어제는 덥지 않았다."
        },
        {
          "n": "40",
          "text": "어제는 추웠다."
        }
      ]
    },
