    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "왜 너는 영어를 공부하니?"
        },
        {
          "n": "2",
          "text": "이 사람은 나의 친구이다."
        },
        {
          "n": "3",
          "text": "이 책은 비싸다."
        },
        {
          "n": "4",
          "text": "이것들은 나의 책들이다."
        },
        {
          "n": "5",
          "text": "이 책들은 싸다."
        },
        {
          "n": "6",
          "text": "그것들은 너의 책들이다."
        },
        {
          "n": "7",
          "text": "그 책들은 그들의 것들이다."
        },
        {
          "n": "8",
          "text": "그것은 그의 책이다."
        },
        {
          "n": "9",
          "text": "저것은 너의 차다."
        },
        {
          "n": "10",
          "text": "저 집은 나의 것이다."
        },
        {
          "n": "11",
          "text": "이 신사가 그것을 했다."
        },
        {
          "n": "12",
          "text": "왜 너는 영어를 공부했니?"
        },
        {
          "n": "13",
          "text": "왜 너는 영어를 공부하고 있니?"
        },
        {
          "n": "14",
          "text": "왜 너는 영어를 공부하고 있었니?"
        },
        {
          "n": "15",
          "text": "언제 그는 영어를 공부하고 있었니?"
        },
        {
          "n": "16",
          "text": "그녀는 어디에서 영어를 공부하고 있었니?"
        },
        {
          "n": "17",
          "text": "그들은 어디에서 영어를 공부하고 있었니?"
        },
        {
          "n": "18",
          "text": "왜 너는 행복하니?"
        }
      ]
    },
