    {
      "type": "sentences",
      "items": [
        {
          "n": "56",
          "text": "너는 그것을 나에게 주지 않을래?"
        },
        {
          "n": "57",
          "text": "너는 무엇을 원하니?"
        },
        {
          "n": "58",
          "text": "그 희생자들의 세 사람은 덴마크인 이 아니었나?"
        },
        {
          "n": "59",
          "text": "그것은 그렇게 더럽지는 않지?"
        },
        {
          "n": "60",
          "text": "누가 하버드 사람들에 대한 너의 의견을 바꾸었니?"
        },
        {
          "n": "61",
          "text": "그들이 모두 너 같지는 않지?"
        },
        {
          "n": "62",
          "text": "누가 너희를 태워주었니?"
        },
        {
          "n": "63",
          "text": "내가 너같이 보이니?"
        },
        {
          "n": "64",
          "text": "그들이 너의 집을 보려하지 않았니?"
        },
        {
          "n": "65",
          "text": "누가 너의 형제들을 만나기 원하니?"
        },
        {
          "n": "66",
          "text": "우리는 다음에 그것을 할꺼야."
        },
        {
          "n": "67",
          "text": "그 커피를 잊지 말아라."
        },
        {
          "n": "68",
          "text": "너는 그런 말하지 않았지?"
        },
        {
          "n": "69",
          "text": "왜 너는 택시를 타지 않았니?"
        },
        {
          "n": "70",
          "text": "우리는 함께 대학에 다녔지?"
        },
        {
          "n": "71",
          "text": "그것은 너의 성전환수술을 카버 하겠지?"
        },
        {
          "n": "72",
          "text": "내가 무엇을 이해하지 않나?"
        },
        {
          "n": "73",
          "text": "누가 그 내기에 이겼나?"
        },
        {
          "n": "74",
          "text": "누가 세상을 바꿨나?"
        }
      ]
    },
