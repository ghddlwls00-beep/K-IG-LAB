        {
          "n": "24",
          "text": "그는 그것을 좋아한다."
        },
        {
          "n": "25",
          "text": "그들은 그것을 좋아한다."
        },
        {
          "n": "26",
          "text": "너는 나를 안다."
        },
        {
          "n": "27",
          "text": "내가 너를 아니 (댁에서 나를 아세요?)"
        },
        {
          "n": "28",
          "text": "그는 그것을 좋아하나?"
        },
        {
          "n": "29",
          "text": "그들은 그것을 좋아하나?"
        },
        {
          "n": "30",
          "text": "너는 그것을 좋아하니?"
        },
        {
          "n": "31",
          "text": "나는 그를 알았다."
        },
        {
          "n": "32",
          "text": "그는 그것을 좋아했다."
        },
        {
          "n": "33",
          "text": "그들은 그것을 좋아했다."
        },
        {
          "n": "34",
          "text": "너는 나를 알았다."
        },
        {
          "n": "35",
          "text": "내가 그를 알았나?"
        },
        {
          "n": "36",
          "text": "그가 그것을 좋아했나?"
        },
        {
          "n": "37",
          "text": "그들이 그것을 좋아했나?"
        },
        {
          "n": "38",
          "text": "한 소년이 없었니(있지 않았니)?"
        },
        {
          "n": "39",
          "text": "소년들이 있지 않았니? (없었니?)"
        },
        {
          "n": "40",
          "text": "내가 꿈을 갖고 있지 않았니? (나에게 꿈이 있지 않았니?)"
        },
        {
          "n": "41",
          "text": "너는 꿈을 갖고 있지 않았니?"
        },
        {
          "n": "42",
          "text": "그가 꿈을 갖고 있지 않았니?"
        },
        {
          "n": "43",
          "text": "그들이 꿈을 갖고 있지 않았니?"
        },
        {
          "n": "44",
          "text": "너는 그것을 좋아하지 않았니?"
        },
        {
          "n": "45",
          "text": "그는 그것을 좋아하지 않았니?"
