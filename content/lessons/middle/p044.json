    },
    {
      "type": "instruction",
      "text": "Mother’s brother and sister"
    },
    {
      "type": "hints",
      "text": "My mother is the youngest child in her family."
    },
    {
      "type": "instruction",
      "text": "She has two older brothers and two sisters."
    },
    {
      "type": "instruction",
      "text": "My uncles and aunts are all married,"
    },
    {
      "type": "instruction",
      "text": "so I have a lot of cousins as well."
    },
    {
      "type": "instruction",
      "text": "Because grandfather passed away several years ago,"
    },
    {
      "type": "instruction",
      "text": "my grandmother lives with my mother’s eldest brother."
    },
