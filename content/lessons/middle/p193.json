    {
      "type": "hints",
      "text": "Another unique aspect of Korean culture is its food."
    },
    {
      "type": "instruction",
      "text": "Traditional Korean meals usually include boiled rice, soup, fish"
    },
    {
      "type": "instruction",
      "text": "or meat, several vegetable side dishes,"
    },
    {
      "type": "instruction",
      "text": "and one or more kinds of kimchi."
    },
    {
      "type": "instruction",
      "text": "My favorite food is bulgogi."
    },
    {
      "type": "instruction",
      "text": "Bulgogi is the most popular Korean meat dish,"
    },
    {
      "type": "instruction",
      "text": "while the most popular vegetable dish is kimchi."
    },
    {
      "type": "instruction",
      "text": "I like them both."
    },
