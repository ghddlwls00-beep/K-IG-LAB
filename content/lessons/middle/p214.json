      "text": "[ K-IG 교육- 214]"
    },
    {
      "type": "instruction",
      "text": "(Relatives-Introduction)"
    },
    {
      "type": "hints",
      "text": "I have many relatives because"
    },
    {
      "type": "instruction",
      "text": "both my father and mother have many brothers and sisters."
    },
    {
      "type": "instruction",
      "text": "My uncles and aunts are all married,"
    },
    {
      "type": "instruction",
      "text": "so I have a lot of cousins as well."
    },
    {
      "type": "instruction",
      "text": "My favorite relative is my oldest uncle."
    },
    {
      "type": "instruction",
      "text": "My family visits him twice a month."
    },
    {
      "type": "instruction",
      "text": "He has children who are similar in age to me."
    },
    {
      "type": "instruction",
      "text": "When we get together, we usually go out for dinner."
    },
