    {
      "type": "instruction",
      "text": "Father’s brother and sister"
    },
    {
      "type": "hints",
      "text": "First of all, my father has two brothers and two sisters."
    },
    {
      "type": "instruction",
      "text": "My mother also has two brothers and two sisters."
    },
    {
      "type": "instruction",
      "text": "My father is the second son."
    },
    {
      "type": "instruction",
      "text": "My grandparents live with my oldest uncle."
    },
    {
      "type": "instruction",
      "text": "Some of my aunts and uncles live near my house"
    },
    {
      "type": "instruction",
      "text": "so I often go and visit them, or they come and visit me."
