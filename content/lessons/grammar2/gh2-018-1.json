    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "그것은 실수였다."
        },
        {
          "n": "2",
          "text": "한 가지 실수(착오)가 있었다."
        },
        {
          "n": "3",
          "text": "여기 한 문제가 있다."
        },
        {
          "n": "4",
          "text": "한 소년이 있었다."
        },
        {
          "n": "5",
          "text": "거기에 한 소년이 있었다."
        },
        {
          "n": "6",
          "text": "그는 그것에 성공했다."
        },
        {
          "n": "7",
          "text": "그는 그 왕좌를 계승했다."
        },
        {
          "n": "8",
          "text": "그는 수상으로써 그녀를 계승했다."
        },
        {
          "n": "9",
          "text": "그녀는 두통을 앓고 있다."
        },
        {
          "n": "10",
          "text": "그 회사는 큰 손실을 입었다."
        },
        {
          "n": "11",
          "text": "너는 너의 악한 방식을 바꾸어야 한다."
        },
        {
          "n": "12",
          "text": "너는 내가 마지막으로(지난번에) 본 이래로 많이 변했다."
        },
        {
          "n": "13",
          "text": "그 회원들은 그 계획에 반대했다."
        },
        {
          "n": "14",
          "text": "그 식물은 빨리 자란다."
        },
        {
          "n": "15",
          "text": "날이 어두워졌다."
        },
        {
          "n": "16",
          "text": "그는 턱수염을 길렀다."
        },
        {
          "n": "17",
          "text": "나는 그녀의 팔을 잡았다."
        },
        {
          "n": "18",
          "text": "나는 그녀를 품에 안았다."
        },
        {
          "n": "19",
          "text": "나를 그렇게 껴안지 말아라."
        },
        {
          "n": "20",
          "text": "그는 나를 바보로 여겼다."
        },
        {
          "n": "21",
          "text": "그 닻이 얼마나 오래 견딜까?"
        },
        {
          "n": "22",
          "text": "그 약속은 여전히 유효하다."
        },
        {
          "n": "23",
          "text": "한 대회가 열렸다."
        },
        {
          "n": "24",
          "text": "겨자는 빼주세요."
        },
        {
          "n": "25",
          "text": "우리는 도난에 대해서 책임을 지지 않는다."
        }
      ]
    },
