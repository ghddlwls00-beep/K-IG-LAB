        {
          "n": "1",
          "text": "Criminals are to be punished."
        },
        {
          "n": "2",
          "text": "This is too heavy for me to carry."
        },
        {
          "n": "3",
          "text": "This is so heavy that I can not carry."
        },
        {
          "n": "4",
          "text": "My boss is so stingy that he brown-bags it all the time."
        },
        {
          "n": "5",
          "text": "He is sure to come tomorrow."
        },
        {
          "n": "6",
          "text": "Senators voted to reject the bill."
        },
        {
          "n": "7",
          "text": "He got her to type the letter."
        },
        {
          "n": "8",
          "text": "He let her do it her way."
        },
        {
          "n": "9",
          "text": "Nobody made her study English."
        },
        {
          "n": "10",
          "text": "He helped her do her homework."
        },
        {
          "n": "11",
          "text": "He asked me to let George build my house."
        },
        {
          "n": "12",
          "text": "He read the letter written by her."
        },
        {
          "n": "13",
          "text": "I'd like to have a phone installed(my phone disconnected) in my apartment."
        },
        {
          "n": "14",
          "text": "Where did you have your new suit custom-tailored?"
        },
        {
          "n": "15",
          "text": "I bought it off the rack."
        },
        {
          "n": "16",
          "text": "I had a little alteration(혹은 a few alterations) made."
        },
        {
          "n": "17",
          "text": "Who is the girl to sing?"
        },
        {
          "n": "18",
          "text": "Who is the girl studying in my study?"
        }
