    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "그는 하루에 15시간을 일하면서 그것을 끝냈다."
        },
        {
          "n": "2",
          "text": "왜 너는 나를 피하는 것을 계속하니?(왜 계속 나를 피하니?)"
        },
        {
          "n": "3",
          "text": "담배를 끄시는 것을 꺼려하시겠습니까? (담뱃불 좀 꺼주시겠습니까?)"
        },
        {
          "n": "4",
          "text": "물론 꺼려하지 않습니다(물론입니다)."
        },
        {
          "n": "5",
          "text": "나는 그녀와 함께 가는 것을 고집하지 않았다."
        },
        {
          "n": "6",
          "text": "그는 정확한 것을 자랑스러워한다.(정확한 것에 대한 자부심을 갖고 있다)."
        },
        {
          "n": "7",
          "text": "그는 자기 아버지의 부유한 것을 자랑스러워한다."
        },
        {
          "n": "8",
          "text": "나는 살아서 내 아들이 부유해지고 결혼하는 것을 보고 싶다."
        },
        {
          "n": "9",
          "text": "그녀는 그가 경상도 사투리로 말하는 것을 듣고 미소 지었다."
        },
        {
          "n": "10",
          "text": "나는 그가 방을 청소하는 것을 보았다."
        },
        {
          "n": "11",
          "text": "나는 그가 운전하는 것을 지켜보았다."
        },
        {
          "n": "12",
          "text": "나는 남자가 비는 것(구걸하는 것)을 보고 싶지 않다."
        },
        {
          "n": "13",
          "text": "당신은 저 너머에 서있는 그 숙녀를 압니까?"
        },
        {
          "n": "14",
          "text": "당신은 그 소년이 저 너머에 서있는 것을 보았습니까?"
        },
        {
          "n": "15",
          "text": "그는 부산에 가는 것을 연기했다."
        },
        {
          "n": "16",
          "text": "당신은 내가 여기에 앉는 것을 꺼리십니까?(내가 여기에 앉아도 괜찮겠습니까?)"
        },
        {
          "n": "17",
          "text": "나는 그 기사를 읽는 것을 즐겨왔다."
        },
        {
          "n": "18",
          "text": "나는 그것에 책임이 있다고 확신한다."
        },
        {
          "n": "19",
          "text": "나는 네가 그것에 책임이 있다고 확신한다."
        }
      ]
    },
