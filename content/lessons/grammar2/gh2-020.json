    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "He turned down my request."
        },
        {
          "n": "2",
          "text": "That sounds great."
        },
        {
          "n": "3",
          "text": "He came back safe and sound."
        },
        {
          "n": "4",
          "text": "Sound travels more slowly than light."
        },
        {
          "n": "5",
          "text": "I heard a strange sound outside."
        },
        {
          "n": "6",
          "text": "They sound the bell every hour at the temple."
        },
        {
          "n": "7",
          "text": "I found the tool easily."
        },
        {
          "n": "8",
          "text": "The agency found him useful."
        },
        {
          "n": "9",
          "text": "I find the new house very comfortable."
        },
        {
          "n": "10",
          "text": "The judge found him guilty."
        },
        {
          "n": "11",
          "text": "Watch your language."
        },
        {
          "n": "12",
          "text": "I didn't mean to hurt you."
        },
        {
          "n": "13",
          "text": "Does it hurt?"
        },
        {
          "n": "14",
          "text": "What is this called?"
        },
        {
          "n": "15",
          "text": "Feel free to call me any time."
        },
        {
          "n": "16",
          "text": "Mind your own business."
        },
        {
          "n": "17",
          "text": "Never mind."
        },
        {
          "n": "18",
          "text": "I don't mind."
        },
        {
          "n": "19",
          "text": "Please remember me to your wife."
        },
        {
          "n": "20",
          "text": "I remember seeing you somewhere."
        },
        {
          "n": "21",
          "text": "I remember to see you tomorrow."
        },
        {
          "n": "22",
          "text": "Don't leave the door open."
        },
        {
          "n": "23",
          "text": "Don't leave me."
        },
        {
          "n": "24",
          "text": "Leave me alone."
        },
        {
          "n": "25",
          "text": "He left Seoul for New York."
        },
        {
          "n": "26",
          "text": "Americans don't eat fish raw."
        }
      ]
    },
