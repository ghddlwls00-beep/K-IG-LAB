    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "Dozens of farm workers got sick enough to be sent to hospitals."
        },
        {
          "n": "2",
          "text": "He was in too much pain to do much talking."
        },
        {
          "n": "3",
          "text": "She didn't want to marry me because I was broke."
        },
        {
          "n": "4",
          "text": "You chose to go."
        },
        {
          "n": "5",
          "text": "He is on another line now."
        },
        {
          "n": "6",
          "text": "Would you like to hold on or call again?"
        },
        {
          "n": "7",
          "text": "He went to Pusan on business."
        },
        {
          "n": "8",
          "text": "Would you like to leave your name and phone number?"
        },
        {
          "n": "9",
          "text": "Please tell him George called."
        },
        {
          "n": "10",
          "text": "Care to leave a message?"
        },
        {
          "n": "11",
          "text": "Your car is ready to go."
        },
        {
          "n": "12",
          "text": "Will you be free to have lunch with me?"
        },
        {
          "n": "13",
          "text": "I am just not in the mood to eat out tonight."
        },
        {
          "n": "14",
          "text": "Since I was in a hurry, I thought I had no choice but (to)step on it."
        },
        {
          "n": "15",
          "text": "Shall I get you something to drink?"
        },
        {
          "n": "16",
          "text": "What do you have?"
        },
        {
          "n": "17",
          "text": "I happened to be in the neighborhood, so I just dropped in to say hello."
        }
      ]
    },
