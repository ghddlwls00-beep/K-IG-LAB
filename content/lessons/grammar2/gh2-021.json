    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "The President appointed him his secretary."
        },
        {
          "n": "2",
          "text": "What has brought you here?"
        },
        {
          "n": "3",
          "text": "Can you give me a hand?"
        },
        {
          "n": "4",
          "text": "I'm sorry but I have my hands full."
        },
        {
          "n": "5",
          "text": "Give me a break this time."
        },
        {
          "n": "6",
          "text": "They lent me some money."
        },
        {
          "n": "7",
          "text": "I want to borrow some money."
        },
        {
          "n": "8",
          "text": "Wish me luck."
        },
        {
          "n": "9",
          "text": "I wish you the best of luck."
        },
        {
          "n": "10",
          "text": "My father wanted to make me a lawyer."
        },
        {
          "n": "11",
          "text": "He made it."
        },
        {
          "n": "12",
          "text": "I must make you an apology."
        },
        {
          "n": "13",
          "text": "Let me make you amends for your loss."
        },
        {
          "n": "14",
          "text": "He made his mother happy."
        },
        {
          "n": "15",
          "text": "Prosperity makes friends."
        },
        {
          "n": "16",
          "text": "I will make you a new dress."
        },
        {
          "n": "17",
          "text": "What kind of a king will he make?"
        },
        {
          "n": "18",
          "text": "Love makes all men equal."
        },
        {
          "n": "19",
          "text": "He made the burden heavier."
        },
        {
          "n": "20",
          "text": "He made a great contribution to the rescue effort."
        },
        {
          "n": "21",
          "text": "You may make free use of my library."
        },
        {
          "n": "22",
          "text": "I felt myself guilty."
        },
        {
          "n": "23",
          "text": "I feel tired."
        }
      ]
    },
