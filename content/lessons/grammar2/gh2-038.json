      "items": [
        {
          "n": "1",
          "text": "He finished it working 15 hours a day."
        },
        {
          "n": "2",
          "text": "Why do you keep avoiding me?"
        },
        {
          "n": "3",
          "text": "Would you mind putting out your cigarette?"
        },
        {
          "n": "4",
          "text": "Of course not."
        },
        {
          "n": "5",
          "text": "I didn't insist on going with her."
        },
        {
          "n": "6",
          "text": "He is proud of being punctual."
        },
        {
          "n": "7",
          "text": "He is proud of his father's being rich."
        },
        {
          "n": "8",
          "text": "I want to live to see my son become rich and get married."
        },
        {
          "n": "9",
          "text": "She smiled to hear him talk in Kyungsangdo dialect."
        },
        {
          "n": "10",
          "text": "I saw him clean the room."
        },
        {
          "n": "11",
          "text": "I watched him drive."
        },
        {
          "n": "12",
          "text": "I don't want to see a man beg."
        },
        {
          "n": "13",
          "text": "Do you know the lady standing over there?"
        },
        {
          "n": "14",
          "text": "Did you see the boy stand(ing) over there?"
        },
        {
          "n": "15",
          "text": "He put off going to Pusan."
        },
        {
          "n": "16",
          "text": "Do you mind my sitting here?"
        },
        {
          "n": "17",
          "text": "I have enjoyed reading the article."
        },
        {
          "n": "18",
          "text": "I am sure of being responsible for it."
        },
        {
          "n": "19",
          "text": "I am sure of your being responsible for it."
        }
      ]
