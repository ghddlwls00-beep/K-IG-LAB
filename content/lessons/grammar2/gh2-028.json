      "items": [
        {
          "n": "1",
          "text": "I will pick up the tab."
        },
        {
          "n": "2",
          "text": "This is on me."
        },
        {
          "n": "3",
          "text": "I'm buying today."
        },
        {
          "n": "4",
          "text": "I'm treating."
        },
        {
          "n": "5",
          "text": "Let's go Dutch."
        },
        {
          "n": "6",
          "text": "Waiter, will you take our order?"
        },
        {
          "n": "7",
          "text": "What does your husband do for a living?"
        },
        {
          "n": "8",
          "text": "What is your husband doing?"
        },
        {
          "n": "9",
          "text": "It fits you perfectly."
        },
        {
          "n": "10",
          "text": "He is a Korean by birth but an American by citizenship."
        },
        {
          "n": "11",
          "text": "He is a naturalized citizen."
        },
        {
          "n": "12",
          "text": "What seems to be the problem?"
        },
        {
          "n": "13",
          "text": "I am afraid I have a cavity."
        },
        {
          "n": "14",
          "text": "Do you think he will forget us once he becomes rich and famous?"
        },
        {
          "n": "15",
          "text": "I'm afraid so."
        },
        {
          "n": "16",
          "text": "I hope not."
        },
        {
          "n": "17",
          "text": "You look familiar."
        },
        {
          "n": "18",
          "text": "Do I know you?"
        },
        {
          "n": "19",
          "text": "You have a very good memory."
        },
        {
          "n": "20",
          "text": "Can you see me?"
        },
        {
          "n": "21",
          "text": "Do you have company?"
        },
        {
          "n": "22",
          "text": "Do you have a company?"
        },
        {
          "n": "23",
          "text": "How do you spell your name?"
        },
        {
          "n": "24",
          "text": "Call me Bill."
        },
        {
          "n": "25",
          "text": "Don't sir me."
        },
        {
          "n": "26",
          "text": "Don't mister me."
        }
      ]
