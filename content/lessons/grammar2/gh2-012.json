        {
          "n": "1",
          "text": "You must finish it by this Friday."
        },
        {
          "n": "2",
          "text": "The telephone is by the window."
        },
        {
          "n": "3",
          "text": "The play was written by Shakespeare."
        },
        {
          "n": "4",
          "text": "He was shot by a terrorist with a gun."
        },
        {
          "n": "5",
          "text": "He shocked the whole company by resigning."
        },
        {
          "n": "6",
          "text": "Since then, I have studied English."
        },
        {
          "n": "7",
          "text": "After work, I went home."
        },
        {
          "n": "8",
          "text": "Shortly after lunch, they got back to work."
        },
        {
          "n": "9",
          "text": "I don't know anything about it."
        },
        {
          "n": "10",
          "text": "He has about one hundred dollars."
        },
        {
          "n": "11",
          "text": "He swam across the Han River."
        },
        {
          "n": "12",
          "text": "All the people across the town know him."
        },
        {
          "n": "13",
          "text": "There is a regulation against smoking in this company."
        },
        {
          "n": "14",
          "text": "Passengers are warned against pickpockets."
        },
        {
          "n": "15",
          "text": "He stood up against the dictator."
        },
        {
          "n": "16",
          "text": "He left three hours later."
        },
        {
          "n": "17",
          "text": "He returned after three hours."
        },
        {
          "n": "18",
          "text": "Fish can survive for only a short time out of water."
        }
