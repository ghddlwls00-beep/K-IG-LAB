    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "I ask you out of curiosity."
        },
        {
          "n": "2",
          "text": "He went out of the room."
        },
        {
          "n": "3",
          "text": "As a Christian, how could you lie?"
        },
        {
          "n": "4",
          "text": "He is twice as rich as you are."
        },
        {
          "n": "5",
          "text": "I respect him as a soldier."
        },
        {
          "n": "6",
          "text": "Shall I take a message?"
        },
        {
          "n": "7",
          "text": "I can not solve the problem."
        },
        {
          "n": "8",
          "text": "He must be a spy."
        },
        {
          "n": "9",
          "text": "You should(must) come here by ten o'clock."
        },
        {
          "n": "10",
          "text": "He will die."
        },
        {
          "n": "11",
          "text": "I will study English hard."
        },
        {
          "n": "12",
          "text": "He would not answer."
        },
        {
          "n": "13",
          "text": "It would be fine tomorrow."
        },
        {
          "n": "14",
          "text": "He would go to the library when he prepared for the examination."
        },
        {
          "n": "15",
          "text": "He shall be fifteen tomorrow."
        },
        {
          "n": "16",
          "text": "I could go to college with the money."
        },
        {
          "n": "17",
          "text": "Nowadays no one could do that."
        },
        {
          "n": "18",
          "text": "He may be a millionaire."
        },
        {
          "n": "19",
          "text": "You may go."
        },
        {
          "n": "20",
          "text": "He will(would) solve the problem."
        },
        {
          "n": "21",
          "text": "He might be rich."
        },
        {
          "n": "22",
          "text": "You need to study English."
        },
        {
          "n": "23",
          "text": "You need not study English."
        }
      ]
    },
