        {
          "n": "1",
          "text": "It's the wrong size."
        },
        {
          "n": "2",
          "text": "Can I exchange this?"
        },
        {
          "n": "3",
          "text": "Sign this refund check and take it to the cashier."
        },
        {
          "n": "4",
          "text": "It's a real good buy."
        },
        {
          "n": "5",
          "text": "You look down."
        },
        {
          "n": "6",
          "text": "I asked Betty out but she turned me down."
        },
        {
          "n": "7",
          "text": "Will you give me a wake-up call at 7 tomorrow morning?"
        },
        {
          "n": "8",
          "text": "Would he mind if I ask him to direct me to the station?"
        },
        {
          "n": "9",
          "text": "Will you give me directions?"
        },
        {
          "n": "10",
          "text": "Are there any landmarks near it?"
        },
        {
          "n": "11",
          "text": "What's the most prominent building near it?"
        },
        {
          "n": "12",
          "text": "Are you going my way?"
        },
        {
          "n": "13",
          "text": "Drop me at the bank."
        },
        {
          "n": "14",
          "text": "Can I take an airport-bound bus here?"
        },
        {
          "n": "15",
          "text": "How often do the trains run on this route? About every ten minutes."
        },
        {
          "n": "16",
          "text": "Are there through buses to the airport?"
        },
        {
          "n": "17",
          "text": "I never get carsick but I always get airsick (aboard a plane) or seasick (aboard a ship)."
        },
        {
          "n": "18",
          "text": "The machine doesn't work right."
        }
      ]
