    },
    {
      "type": "sentences",
      "items": [
        {
          "n": "1",
          "text": "나는 호기심으로부터 너에게 묻는다."
        },
        {
          "n": "2",
          "text": "그는 그 방으로부터 나갔다."
        },
        {
          "n": "3",
          "text": "기독교인으로써 어떻게 너는 거짓말을 할 수 있나?"
        },
        {
          "n": "4",
          "text": "그는 너보다 두 배 부자다."
        },
        {
          "n": "5",
          "text": "나는 군인으로써 그를 존경한다."
        },
        {
          "n": "6",
          "text": "제가 메시지를 받을까요(말씀 전해드릴까요?)"
        },
        {
          "n": "7",
          "text": "나는 그 문제를 풀 수 없다."
        },
        {
          "n": "8",
          "text": "그는 간첩임에 틀림없다."
        },
        {
          "n": "9",
          "text": "너는 열시까지 여기 와야 한다."
        },
        {
          "n": "10",
          "text": "그는 죽을 것이다."
        },
        {
          "n": "11",
          "text": "나는 영어를 열심히 공부하겠다."
        },
        {
          "n": "12",
          "text": "그는 대답하지 않으려 한다(했다, 할 것이다)."
        },
        {
          "n": "13",
          "text": "내일 날씨가 좋을 것이다."
        },
        {
          "n": "14",
          "text": "그는 그 시험에 대하여 준비할 때 도서관에 가곤 했다."
        },
        {
          "n": "15",
          "text": "그는 내일 15살이 될 것이다."
        },
        {
          "n": "16",
          "text": "나는 그 돈으로 대학에 갈 수 있을 것이다(갈 수 있었다)."
        },
        {
          "n": "17",
          "text": "요즈음 아무도 그것을 할 수 없을 것이다."
        },
        {
          "n": "18",
          "text": "그는 백만장자일지 모른다."
        },
        {
          "n": "19",
          "text": "당신은 가도 좋다."
        },
        {
          "n": "20",
          "text": "그는 그 문제를 해결할 것이다."
        },
        {
          "n": "21",
          "text": "그는 부자일지 모른다."
        },
        {
          "n": "22",
          "text": "당신은 영어를 공부할 필요가 있다."
        },
        {
          "n": "23",
          "text": "너는 영어를 공부할 필요가 없다."
        }
      ]
    },
